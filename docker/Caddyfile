# Раздача собранного сайта внутри контейнера web (для локальной проверки; на сервере файлы отдаёт Caddy из deploy)
{
	admin off
	auto_https off
}
:8080 {
	root * /srv/dist
	encode zstd gzip
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
